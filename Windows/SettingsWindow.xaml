<Window x:Class="OctoCapture.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OctoCapture 설정" Width="520" SizeToContent="Height"
        Icon="pack://application:,,,/OctoCapture.ico"
        Background="#1E1E22" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2F9BFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#55555C"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="HotkeyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="150"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
        <StackPanel Margin="20,10,20,16">
            <TextBlock Style="{StaticResource GroupTitle}" Text="일반"/>
            <CheckBox x:Name="ChkStartup" Content="Windows 시작 시 자동 실행 (시작프로그램 등록)"/>
            <CheckBox x:Name="ChkTray" Content="닫기 버튼을 누르면 트레이로 최소화"/>
            <CheckBox x:Name="ChkClipboard" Content="캡쳐와 동시에 클립보드에 복사"/>
            <CheckBox x:Name="ChkOpenEditor" Content="캡쳐 후 편집기 자동 열기"/>

            <TextBlock Style="{StaticResource GroupTitle}" Text="저장"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSaveFolder" Grid.Column="0" Background="#2A2A2E" Foreground="#EEEEEE"
                         BorderBrush="#55555C" Padding="6,3" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="찾아보기…" Margin="8,0,0,0" Padding="10,4" Click="Browse_Click"/>
            </Grid>
            <TextBlock Text="비워두면 사진 폴더의 OctoCapture 폴더를 사용합니다." Foreground="#77777C" FontSize="11" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="기본 이미지 형식" Width="150"/>
                <ComboBox x:Name="CmbImageFormat" Width="100">
                    <ComboBoxItem Content="PNG"/>
                    <ComboBoxItem Content="JPG"/>
                    <ComboBoxItem Content="BMP"/>
                </ComboBox>
                <TextBlock Text="기본 동영상 형식" Width="130" Margin="20,0,0,0"/>
                <ComboBox x:Name="CmbVideoFormat" Width="100">
                    <ComboBoxItem Content="MP4"/>
                    <ComboBoxItem Content="GIF"/>
                    <ComboBoxItem Content="WebP"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Style="{StaticResource GroupTitle}" Text="녹화"/>
            <CheckBox x:Name="ChkSysAudio" Content="시스템 소리 포함 (기본값)"/>
            <CheckBox x:Name="ChkMic" Content="마이크 포함 (기본값)"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="녹화 프레임(FPS)" Width="150"/>
                <ComboBox x:Name="CmbFps" Width="100">
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="60"/>
                </ComboBox>
                <TextBlock Text="GIF 프레임(FPS)" Width="130" Margin="20,0,0,0"/>
                <ComboBox x:Name="CmbGifFps" Width="100">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="25"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Style="{StaticResource GroupTitle}" Text="단축키 (클릭 후 원하는 키 조합 입력, Esc: 해제)"/>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Style="{StaticResource HotkeyLabel}" Text="직접 캡쳐"/>
                    <TextBox x:Name="HkRegion" Style="{StaticResource HotkeyBox}" PreviewKeyDown="Hotkey_KeyDown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Style="{StaticResource HotkeyLabel}" Text="창 캡쳐"/>
                    <TextBox x:Name="HkWindow" Style="{StaticResource HotkeyBox}" PreviewKeyDown="Hotkey_KeyDown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Style="{StaticResource HotkeyLabel}" Text="단위별 캡쳐"/>
                    <TextBox x:Name="HkUnit" Style="{StaticResource HotkeyBox}" PreviewKeyDown="Hotkey_KeyDown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Style="{StaticResource HotkeyLabel}" Text="화면 캡쳐 (현재 모니터)"/>
                    <TextBox x:Name="HkMonitor" Style="{StaticResource HotkeyBox}" PreviewKeyDown="Hotkey_KeyDown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Style="{StaticResource HotkeyLabel}" Text="전체 캡쳐 (모든 모니터)"/>
                    <TextBox x:Name="HkFull" Style="{StaticResource HotkeyBox}" PreviewKeyDown="Hotkey_KeyDown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Style="{StaticResource HotkeyLabel}" Text="스크롤 캡쳐"/>
                    <TextBox x:Name="HkScroll" Style="{StaticResource HotkeyBox}" PreviewKeyDown="Hotkey_KeyDown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Style="{StaticResource HotkeyLabel}" Text="녹화 시작/종료"/>
                    <TextBox x:Name="HkRecord" Style="{StaticResource HotkeyBox}" PreviewKeyDown="Hotkey_KeyDown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Style="{StaticResource HotkeyLabel}" Text="메인 창 열기"/>
                    <TextBox x:Name="HkShowMain" Style="{StaticResource HotkeyBox}" PreviewKeyDown="Hotkey_KeyDown"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="저장" Width="90" Padding="0,6" Margin="0,0,8,0" Click="Ok_Click"/>
                <Button Content="취소" Width="90" Padding="0,6" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
