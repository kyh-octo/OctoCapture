<Window x:Class="OctoCapture.Windows.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OctoCapture - 동영상 재생/편집" Height="660" Width="960" MinHeight="420" MinWidth="620"
        Icon="pack://application:,,,/OctoCapture.ico"
        Background="#1E1E22" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PlayerBtn" TargetType="Button">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#3A3A40"/>
            <Setter Property="BorderBrush" Value="#55555C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A4A52"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2F9BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#2A2A2E" Padding="12,8">
            <StackPanel>
                <!-- 탐색 슬라이더 + 구간 밴드 + 드래그 가능한 [ ] 핸들 -->
                <Grid x:Name="SeekHost" Height="36" Margin="0,18,0,6">
                    <Border x:Name="TrimBand" Background="#663FA9F5" Height="10" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"/>
                    <Canvas x:Name="TrimCanvas">
                        <Border x:Name="StartHandle" Width="16" Height="26" CornerRadius="3" Background="#3FA9F5"
                                Cursor="SizeWE" ToolTip="드래그하여 시작 지점 이동" Visibility="Collapsed">
                            <TextBlock Text="[" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <Border x:Name="EndHandle" Width="16" Height="26" CornerRadius="3" Background="#3FA9F5"
                                Cursor="SizeWE" ToolTip="드래그하여 끝 지점 이동" Visibility="Collapsed">
                            <TextBlock Text="]" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <Border x:Name="DragLabel" Background="#EE222226" BorderBrush="#2F9BFF" BorderThickness="1"
                                CornerRadius="3" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="DragLabelText" Foreground="White" FontSize="11"/>
                        </Border>
                    </Canvas>
                </Grid>

                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                        <Button x:Name="PlayBtn" Style="{StaticResource PlayerBtn}" Content="⏸ 일시정지"
                                MinWidth="90" Click="PlayPause_Click"/>
                        <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" Foreground="#DDDDDD"
                                   FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                        <TextBlock Text="🔊" Foreground="#BBBBBB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" Value="0.8"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                        <Button Style="{StaticResource PlayerBtn}" Content="[ 시작 지점" Click="SetTrimStart_Click"/>
                        <Button Style="{StaticResource PlayerBtn}" Content="끝 지점 ]" Click="SetTrimEnd_Click"/>
                        <Button Style="{StaticResource PlayerBtn}" Content="구간 초기화" Click="ResetTrim_Click"/>
                        <RadioButton x:Name="RadioKeep" GroupName="rangeMode" Content="선택 구간 남기기" IsChecked="True"
                                     Foreground="#DDDDDD" VerticalAlignment="Center" Margin="10,0,0,0" Checked="RangeMode_Changed"/>
                        <RadioButton x:Name="RadioRemove" GroupName="rangeMode" Content="선택 구간 제거"
                                     Foreground="#DDDDDD" VerticalAlignment="Center" Margin="8,0,0,0" Checked="RangeMode_Changed"/>
                        <TextBlock x:Name="TrimLabel" Text="구간: 전체" Foreground="#3FA9F5"
                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                        <Button Style="{StaticResource PlayerBtn}" Content="💾 저장"
                                ToolTip="선택 구간만 남기고 현재 캡쳐에 덮어쓰기" Click="TrimOverwrite_Click"/>
                        <Button Style="{StaticResource PlayerBtn}" Content="＋ 새 캡쳐 저장"
                                ToolTip="선택 구간을 캡쳐 목록에 새 항목으로 추가" Click="TrimToList_Click"/>
                        <Button Style="{StaticResource PlayerBtn}" Content="외부 플레이어" Click="External_Click"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="Space: 재생/일시정지  ·  ←/→: 5초 이동  ·  타임라인의 [ ] 핸들을 드래그해 구간 조절  ·  파일 저장/복사는 메인 화면에서"
                           Foreground="#77777C" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Background="Black">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" ScrubbingEnabled="True"
                          Stretch="Uniform" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"/>
        </Border>
    </DockPanel>
</Window>
