<Window x:Class="OctoCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OctoCapture" Height="640" Width="1020" MinHeight="420" MinWidth="760"
        Icon="pack://application:,,,/OctoCapture.ico"
        Background="#1E1E22" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CapBtn" TargetType="Button">
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#3A3A40"/>
            <Setter Property="BorderBrush" Value="#55555C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A4A52"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2F9BFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource CapBtn}">
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 상단 툴바 -->
        <Border DockPanel.Dock="Top" Background="#2A2A2E" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource CapBtn}" Click="BtnRegion_Click">
                    <TextBlock Text="⬚ 직접 캡쳐"/>
                </Button>
                <Button Style="{StaticResource CapBtn}" Content="🗔 창 캡쳐" Click="BtnWindow_Click"/>
                <Button Style="{StaticResource CapBtn}" Content="▣ 단위별 캡쳐" Click="BtnUnit_Click"/>
                <Button Style="{StaticResource CapBtn}" Content="🖵 화면 캡쳐" Click="BtnMonitor_Click"/>
                <Button Style="{StaticResource CapBtn}" Content="🖥 전체 캡쳐" Click="BtnFull_Click"/>
                <Button Style="{StaticResource CapBtn}" Content="⇅ 스크롤 캡쳐" Click="BtnScroll_Click"/>
                <Rectangle Width="1" Fill="#55555C" Margin="8,4"/>
                <Button x:Name="BtnRecord" Style="{StaticResource CapBtn}" Content="⏺ 화면 녹화" Click="BtnRecord_Click"/>
                <Rectangle Width="1" Fill="#55555C" Margin="8,4"/>
                <Button Style="{StaticResource CapBtn}" Content="⚙ 설정" Click="BtnSettings_Click"/>
            </StackPanel>
        </Border>

        <!-- 본문: 좌측 히스토리 / 우측 미리보기 -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#26262B" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="캡쳐 목록" Foreground="#BBBBBB" FontWeight="Bold"
                               Margin="12,10,12,6"/>
                    <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="HistoryList_SelectionChanged"
                             MouseDoubleClick="HistoryList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="86" Height="60" Background="#151517"
                                            CornerRadius="4">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"/>
                                            <TextBlock Text="▶" FontSize="18" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding PlayIconVisibility}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,2,4,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="#EEEEEE" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TimeText}" Foreground="#88888E" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Info}" Foreground="#88888E" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#26262B" CornerRadius="6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PreviewTitle" Grid.Row="0" Foreground="#BBBBBB" FontWeight="Bold"
                               Text="미리보기" Margin="0,0,0,8"/>

                    <Border Grid.Row="1" Background="#151517" CornerRadius="4">
                        <Grid>
                            <TextBlock x:Name="EmptyHint" Foreground="#66666C" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Text="캡쳐한 이미지가 여기에 표시됩니다.&#10;&#10;상단 버튼 또는 단축키로 캡쳐를 시작하세요."/>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Button x:Name="PlayButton" Style="{StaticResource CapBtn}" Content="▶ 재생"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="Play_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnEdit" Style="{StaticResource SmallBtn}" Content="✎ 편집" Click="Edit_Click"/>
                        <Button x:Name="BtnCopy" Style="{StaticResource SmallBtn}" Content="📋 복사" Click="Copy_Click"/>
                        <Button x:Name="BtnSave" Style="{StaticResource SmallBtn}" Content="💾 저장" Click="Save_Click"/>
                        <Button x:Name="BtnDelete" Style="{StaticResource SmallBtn}" Content="🗑 삭제" Click="Delete_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
